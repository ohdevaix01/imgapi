# Copia este archivo a .env y completa lo que necesites.
# Todo es opcional: sin nada configurado ya funciona.

# Token de HuggingFace (gratis en https://huggingface.co/settings/tokens).
# Sin token, FLUX corta a las pocas imagenes por la cuota ZeroGPU.
# Con token la cuota sube mucho y ademas da acceso a mejores modelos.
HF_TOKEN=

# Token de Pollinations (gratis en https://enter.pollinations.ai).
# Con token se usa la API nueva y se va el limite de 45 segundos.
POLLINATIONS_TOKEN=

# Apikey de Stable Horde (gratis en https://stablehorde.net).
# La anonima (0000000000) alcanza para empezar; una cuenta propia suma concurrency
# y kudos. Con 0 kudos el tope sigue siendo 576x576.
HORDE_API_KEY=0000000000

# Si la defines, /generate exige la clave por X-API-Key o ?key=
API_KEY=

# Orden de intento de proveedores.
PROVIDER_ORDER=flux,pollinations,horde

# Segundos de vida de la cache (604800 = 7 dias)
CACHE_TTL=604800

# Segundos maximos esperando una imagen
GEN_TIMEOUT=180

# Techo de pixeles por imagen. La API nueva de Pollinations rechaza mas de ~2.3 MP.
MAX_PIXELS=2300000

# Espera minima entre llamados a Pollinations sin token (45000 = 45 s)
POLLINATIONS_MIN_GAP_MS=45000
